# The Jellyfin release these images are built from.
#
# Bump this and push to `main` to publish a new build: images are tagged
# :<version> and :latest. The same value on the `dev` branch publishes
# :<version>-dev and :dev, so a pre-release (e.g. 12.2-rc1) can be tested
# there without touching production.

JELLYFIN_VERSION=12.1
